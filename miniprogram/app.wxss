page{background:#f7f4ed;color:#213a34;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{padding:28rpx}.card{background:#fffdf9;border:1rpx solid rgba(190,157,92,.12);border-radius:24rpx;padding:28rpx;box-shadow:0 12rpx 38rpx rgba(48,38,20,.065);margin-bottom:22rpx}.hero{position:relative;overflow:hidden;background:linear-gradient(145deg,#174f43 0%,#092f29 68%,#082722 100%);color:#fff;border-radius:28rpx;padding:38rpx;box-shadow:0 18rpx 46rpx rgba(11,54,45,.18)}.hero::after{content:"";position:absolute;right:-65rpx;top:-90rpx;width:260rpx;height:260rpx;border:1rpx solid rgba(224,195,126,.23);border-radius:50%;box-shadow:0 0 0 35rpx rgba(224,195,126,.055)}.hero>view{position:relative;z-index:1}.title{font-size:38rpx;font-weight:700;letter-spacing:1rpx}.muted{color:#8c9b95;font-size:24rpx}.price{color:#b88435;font-size:36rpx;font-weight:700}.btn{background:linear-gradient(135deg,#d7b76f,#b68438)!important;color:#26362f!important;border-radius:44rpx!important;font-weight:700;box-shadow:0 10rpx 24rpx rgba(174,126,49,.2)}.btn::after{border:0}.ghost{border:1rpx solid #cbb98f!important;background:#fffdf9!important;color:#715829!important}.row{display:flex;align-items:center;justify-content:space-between}.tag{display:inline-block;background:#f5ead1;color:#8a6427;padding:6rpx 14rpx;border-radius:20rpx;font-size:22rpx}.empty{text-align:center;color:#9b9d96;padding:100rpx 0}.section-title{font-weight:700;font-size:32rpx;margin:30rpx 0 18rpx;color:#253e37}.field{background:#f1f5f3;border:1rpx solid #e5ebe8;border-radius:14rpx;padding:22rpx;margin-bottom:18rpx}.danger{color:#b65347}
