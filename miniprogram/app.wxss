page{background:#f3f7f5;color:#173a32;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{padding:28rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;box-shadow:0 10rpx 38rpx rgba(20,65,53,.06);margin-bottom:22rpx}.hero{background:linear-gradient(145deg,#0c4a3d,#0c332d);color:#fff;border-radius:28rpx;padding:38rpx}.title{font-size:38rpx;font-weight:700}.muted{color:#82978f;font-size:24rpx}.price{color:#ad742a;font-size:36rpx;font-weight:700}.btn{background:#17604e!important;color:#fff!important;border-radius:44rpx!important}.btn::after{border:0}.ghost{border:1rpx solid #b9ccc5!important;background:#fff!important;color:#275f51!important}.row{display:flex;align-items:center;justify-content:space-between}.tag{display:inline-block;background:#edf6f2;color:#28705d;padding:6rpx 14rpx;border-radius:20rpx;font-size:22rpx}.empty{text-align:center;color:#91a39d;padding:100rpx 0}.section-title{font-weight:700;font-size:32rpx;margin:30rpx 0 18rpx}.field{background:#f5f8f7;border-radius:14rpx;padding:22rpx;margin-bottom:18rpx}.danger{color:#b74d3d}
