<view class="page" wx:if="{{member}}"><view class="profile hero"><view class="avatar">{{member.nickname?member.nickname[0]:'会'}}</view><view><view class="title">{{member.nickname||'丽水湾会员'}}</view><view class="phone">{{member.phone}}</view></view></view><view class="card menu"><view class="item" data-url="/pages/member-code/index" bindtap="go"><text>▦　我的会员码</text><text>›</text></view><view class="item" data-url="/pages/orders/index" bindtap="go"><text>≡　我的订单</text><text>›</text></view><view class="item" data-url="/pages/notifications/index" bindtap="go"><text>◉　核销通知</text><text>›</text></view><view wx:if="{{member.staffRole==='verifier'||member.staffRole==='admin'}}" class="item admin" data-url="/pages/admin/home/index" bindtap="go"><text>◇　进入管理端</text><text>›</text></view></view><view class="card"><view class="item"><text>门店客服</text><text class="muted">请联系前台</text></view><view class="item"><text>注册时间</text><text class="muted">{{member.createdAt}}</text></view></view><button class="ghost" bindtap="logout">退出登录</button></view>
