.mine-page{padding-bottom:56rpx}
.profile-hero{padding:32rpx 30rpx;margin-bottom:28rpx;background:linear-gradient(145deg,#174f43 0%,#092f29 100%);border:1rpx solid rgba(224,195,126,.22);box-shadow:0 18rpx 48rpx rgba(12,65,54,.18)}
.profile-row{display:flex;align-items:center;gap:22rpx}.avatar{width:104rpx;height:104rpx;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#e7cb88,#cba858);color:#17463b;font-size:44rpx;font-weight:700;flex-shrink:0;box-shadow:inset 0 0 0 4rpx rgba(255,255,255,.24)}
.profile-main{flex:1;min-width:0}.member-name{font-size:36rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.member-phone{margin-top:7rpx;color:#c1d5cf;font-size:25rpx}.member-tag{display:inline-block;margin-top:12rpx;padding:5rpx 14rpx;border-radius:18rpx;background:rgba(222,191,116,.16);border:1rpx solid rgba(222,191,116,.22);color:#e6cb8e;font-size:20rpx}
.profile-actions{flex-shrink:0;display:flex;flex-direction:column;align-items:stretch;gap:12rpx}.edit-profile,.code-compact{min-width:126rpx;box-sizing:border-box;padding:10rpx 15rpx;border-radius:28rpx;text-align:center;color:#fff;font-size:22rpx}.edit-profile{border:1rpx solid rgba(224,195,126,.42);color:#ead39c}.code-compact{display:flex;align-items:center;justify-content:center;gap:8rpx;background:linear-gradient(135deg,#e3ca8e,#cfa65a);color:#193d34;font-weight:700}.code-compact:active{opacity:.78}.code-mini-icon{font-size:25rpx;line-height:1}.arrow{color:#ac9b77;font-size:38rpx;line-height:1}
.section-heading{margin:0 4rpx 18rpx;font-size:29rpx;font-weight:700;color:#264a41}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-bottom:34rpx}.quick-card{padding:27rpx 24rpx;background:#fff;border-radius:22rpx;box-shadow:0 10rpx 34rpx rgba(20,65,53,.055)}.quick-card:active{background:#f8fbfa}
.quick-icon{width:62rpx;height:62rpx;border-radius:17rpx;display:grid;place-items:center;font-size:25rpx;font-weight:700;margin-bottom:20rpx}.cards-icon{background:#e7f4ef;color:#24725d}.order-icon{background:#fff1dc;color:#a96d1f}.quick-name{font-size:29rpx;font-weight:700}.quick-desc{margin-top:8rpx;color:#8b9d97;font-size:21rpx;white-space:nowrap}
.service-list{padding:0 26rpx;margin-bottom:24rpx}.service-item{display:flex;align-items:center;gap:18rpx;padding:26rpx 0;border-bottom:1rpx solid #edf2f0}.service-item:last-child{border-bottom:0}.service-item:active:not(.static-item){opacity:.65}
.service-icon{width:62rpx;height:62rpx;border-radius:17rpx;display:grid;place-items:center;flex-shrink:0;font-size:23rpx;font-weight:700}.notice-icon{background:#edf0fb;color:#536db1}.admin-icon{background:#e7f0f7;color:#245c82}.store-icon{background:#edf6f2;color:#28705d}
.service-main{flex:1;min-width:0}.service-name{font-size:28rpx;font-weight:600}.service-name.admin-name{color:#245c82}.service-desc{margin-top:6rpx;color:#8b9d97;font-size:21rpx}.service-value{color:#8b9d97;font-size:22rpx}
.account-meta{text-align:center;color:#99aaa5;font-size:21rpx;margin:32rpx 0 18rpx}.logout{width:100%;background:transparent!important;color:#7d918b!important;font-size:26rpx}.logout::after{border:0}
.mask{position:fixed;inset:0;background:rgba(6,28,23,.48);z-index:10}.edit-sheet{position:fixed;left:0;right:0;bottom:0;z-index:11;max-height:82vh;overflow-y:auto;box-sizing:border-box;padding:36rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));background:#fff;border-radius:34rpx 34rpx 0 0}
.sheet-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:30rpx}.sheet-title{font-size:35rpx;font-weight:700;color:#173a32}.sheet-subtitle{margin-top:9rpx;color:#879b94;font-size:22rpx}.sheet-close{width:56rpx;height:56rpx;display:grid;place-items:center;border-radius:50%;background:#f1f5f3;color:#6f837d;font-size:38rpx;line-height:1}
.form{display:flex;flex-direction:column;gap:22rpx}.form-item{display:flex;align-items:center;gap:20rpx;min-height:76rpx}.form-item-block{flex-direction:column;align-items:stretch;gap:12rpx}.form-label{width:120rpx;flex-shrink:0;color:#526b64;font-size:27rpx}
.form-input,.form-picker{box-sizing:border-box;width:100%;background:#f5f8f7;border-radius:14rpx;padding:20rpx;font-size:27rpx;color:#173a32}.form-input{flex:1}.form-control{flex:1}.form-picker{display:flex;justify-content:space-between}.form-picker.placeholder{color:#a9bbb6}
.readonly{padding:0 20rpx;background:#f8faf9;border-radius:14rpx}.readonly .form-label{width:100rpx}.form-static{flex:1;color:#173a32;font-size:27rpx}.readonly-tip{color:#9aaba6;font-size:21rpx}.form-textarea{width:100%;min-height:132rpx;box-sizing:border-box;background:#f5f8f7;border-radius:14rpx;padding:20rpx;font-size:27rpx}
.save-btn{margin-top:34rpx;background:linear-gradient(135deg,#d7b76f,#b68438)!important;color:#26362f!important;border-radius:44rpx!important;font-size:28rpx;font-weight:700}.save-btn::after{border:0}
