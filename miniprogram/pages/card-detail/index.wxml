<view class="page" wx:if="{{card}}"><view class="hero"><view class="title">权益卡 #{{card.id}}</view><view class="muted-light">{{card.validFrom}} 至 {{card.validUntil}}</view></view><view class="section-title">剩余权益</view><view class="card"><view class="benefit row" wx:for="{{card.benefits}}" wx:key="benefitId"><text>{{item.item}}</text><b>{{item.type==='unlimited'?'不限次':item.remaining+(item.type==='hours'?' 小时':' 次')}}</b></view></view><view class="section-title">使用记录</view><view wx:if="{{!records.length}}" class="empty">尚未使用</view><view class="record card" wx:for="{{records}}" wx:key="id"><view class="row"><b>{{item.itemSnapshot}}</b><text class="danger">-{{item.quantity}}</text></view><view class="muted">{{item.createdAt}} · 核销人 {{item.operatorName}}</view></view></view>
