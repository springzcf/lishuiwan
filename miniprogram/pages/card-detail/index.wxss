.card-hero{padding-bottom:30rpx;border:1rpx solid rgba(224,195,126,.22)}.muted-light{color:#c8d9d3;margin-top:15rpx;font-size:22rpx}.show-code{display:flex;align-items:center;gap:17rpx;margin-top:30rpx;padding:22rpx;border-radius:20rpx;background:rgba(224,195,126,.12);border:1rpx solid rgba(224,195,126,.25)}.show-code:active{background:rgba(224,195,126,.18)}
.code-icon{width:62rpx;height:62rpx;display:grid;place-items:center;border-radius:16rpx;background:linear-gradient(135deg,#e3ca8e,#cfa65a);color:#193d34;font-size:36rpx}.show-code view{flex:1;display:flex;flex-direction:column}.show-code b{font-size:27rpx}.show-code small{margin-top:6rpx;color:#c9d9d4;font-size:20rpx}.code-arrow{color:#e2c985;font-size:38rpx}.code-disabled{margin-top:28rpx;padding:20rpx;border-radius:18rpx;background:rgba(255,255,255,.09);color:#b9cdc7;text-align:center;font-size:23rpx}
.benefit{padding:20rpx 0;border-bottom:1rpx solid #edf2f0}.benefit:last-child{border:0}.record .muted{margin-top:15rpx}
