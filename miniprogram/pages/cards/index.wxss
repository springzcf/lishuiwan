.pass{background:linear-gradient(145deg,#174f43,#0b332c);color:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:24rpx;box-shadow:0 16rpx 36rpx #174f4328}.pass-top{display:flex;justify-content:space-between}.serial{font-size:18rpx;color:#a8c8bf;letter-spacing:2rpx}.name{font-size:35rpx;font-weight:700;margin-top:10rpx}.benefit{display:flex;justify-content:space-between;margin-top:28rpx;padding-top:20rpx;border-top:1rpx solid #ffffff22}.expiry{color:#b7ccc6;font-size:22rpx;margin-top:28rpx}
