.pass{position:relative;overflow:hidden;background:linear-gradient(135deg,#194f44 0%,#0b332c 72%,#06251f 100%);color:#fff;border:1rpx solid rgba(225,194,121,.28);border-radius:28rpx;padding:30rpx;margin-bottom:24rpx;box-shadow:0 18rpx 42rpx rgba(15,62,52,.2)}.pass::after{content:"VIP";position:absolute;right:-5rpx;top:30rpx;color:rgba(227,199,133,.075);font-size:108rpx;font-weight:800;letter-spacing:5rpx}.pass-top,.benefit,.pass-footer{position:relative;z-index:1}.pass-top{display:flex;justify-content:space-between}.serial{font-size:18rpx;color:#d6bd83;letter-spacing:3rpx}.name{font-size:35rpx;font-weight:700;margin-top:10rpx}.benefit{display:flex;justify-content:space-between;margin-top:28rpx;padding-top:20rpx;border-top:1rpx solid rgba(226,198,132,.2)}.benefit b{color:#ead095}
.pass-footer{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.expiry{color:#bfd0ca;font-size:22rpx}.qr-entry{display:flex;align-items:center;gap:9rpx;padding:12rpx 20rpx;border-radius:28rpx;background:linear-gradient(135deg,#e1c681,#c99e4f);color:#213e36;font-size:23rpx;font-weight:700}.qr-entry:active{opacity:.82}.qr-icon{font-size:30rpx;line-height:1}
