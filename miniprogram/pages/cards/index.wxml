<view class="page">
  <view wx:if="{{!cards.length}}" class="empty">暂时没有权益卡<br/><text class="muted">在首页购买后会显示在这里</text></view>
  <view class="pass" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="detail">
    <view class="pass-top">
      <view><text class="serial">MEMBERSHIP · {{item.id}}</text><view class="name">{{item.productName||'会员权益卡'}}</view></view>
      <text class="tag">{{item.status==='expired'?'已过期':item.status==='used_up'?'已用完':'可使用'}}</text>
    </view>
    <view class="benefit" wx:for="{{item.benefits}}" wx:key="benefitId"><text>{{item.item}}</text><b>{{item.type==='unlimited'?'不限次':item.remaining+(item.type==='hours'?' 小时':' 次')}}</b></view>
    <view class="pass-footer">
      <view class="expiry">有效期至 {{item.validUntil}}</view>
      <view wx:if="{{item.status==='unused'||item.status==='using'}}" class="qr-entry" data-id="{{item.id}}" catchtap="showCode"><text class="qr-icon">▦</text><text>核销码</text></view>
    </view>
  </view>
</view>
