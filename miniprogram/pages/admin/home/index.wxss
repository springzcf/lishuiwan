.admin-page{min-height:100vh;box-sizing:border-box;background:#eef4f8;color:#18344c}.admin-hero{background:linear-gradient(145deg,#234f73 0%,#102f4a 72%,#0b263c 100%);border:1rpx solid rgba(131,190,225,.22);box-shadow:0 18rpx 46rpx rgba(19,57,87,.2)}.admin-hero::after{border-color:rgba(141,201,235,.2);box-shadow:0 0 0 35rpx rgba(126,190,225,.05)}.admin-hero>view:last-child{margin-top:15rpx;color:#c4d9e8}.admin-page .section-title{color:#203f59}.admin-page .field{background:#fff;border-color:#d8e5ed}.quantity-card{height:112rpx;padding:0 18rpx;border:1rpx solid #dce8ef;border-radius:24rpx;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10rpx 28rpx rgba(31,74,105,.08)}.quantity-btn{width:78rpx;height:78rpx;line-height:74rpx;padding:0;border:0;border-radius:20rpx;background:#e7f1f7;color:#245d84;font-size:46rpx;font-weight:600}.quantity-btn::after{border:0}.quantity-input{width:180rpx;height:90rpx;text-align:center;color:#183e5d;font-size:46rpx;font-weight:700}.quantity-tip{margin:14rpx 8rpx 6rpx;color:#718797;font-size:23rpx;line-height:1.55}.scan,.cash{height:180rpx;border:0;border-radius:26rpx;margin:25rpx 0;display:flex;flex-direction:column;align-items:center;justify-content:center}.scan{background:linear-gradient(135deg,#2d739c,#174b70);color:#fff;box-shadow:0 14rpx 32rpx rgba(32,91,130,.2)}.cash{background:#fff;border:1rpx solid #cddfea;color:#285b7c}.scan b,.cash b{font-size:35rpx}.scan small,.cash small{margin-top:8rpx;opacity:.8}.scan-icon{font-size:46rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.grid .card{display:flex;flex-direction:column;border-color:#dce7ee}.grid b{color:#244c68}.grid text{font-size:22rpx;color:#7890a0;margin-top:12rpx}
