.admin-page{min-height:100vh;box-sizing:border-box;background:#eef4f8;color:#18344c;padding-bottom:54rpx}.admin-hero{padding:32rpx 34rpx;background:linear-gradient(145deg,#234f73 0%,#102f4a 72%,#0b263c 100%);border:1rpx solid rgba(131,190,225,.22);box-shadow:0 18rpx 46rpx rgba(19,57,87,.2)}.admin-hero::after{border-color:rgba(141,201,235,.2);box-shadow:0 0 0 35rpx rgba(126,190,225,.05)}.hero-eyebrow{margin-bottom:8rpx;color:#88b8d4;font-size:17rpx;letter-spacing:4rpx}.staff-line{display:flex;align-items:center;gap:10rpx;margin-top:15rpx;color:#c4d9e8;font-size:22rpx}.online-dot{width:10rpx;height:10rpx;border-radius:50%;background:#62cf9b;box-shadow:0 0 0 6rpx rgba(98,207,155,.12)}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:34rpx 4rpx 18rpx}.section-head>view{display:flex;flex-direction:column;gap:5rpx}.section-head b{color:#203f59;font-size:31rpx}.section-head view text{color:#8295a2;font-size:21rpx}.frequency-tag{padding:6rpx 14rpx;border-radius:20rpx;background:#dcecf5;color:#28658c;font-size:20rpx}.verify-panel{padding:0 26rpx 26rpx;border-color:#d7e5ed}.form-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:26rpx 0}.form-meta{display:flex;align-items:center;gap:16rpx;min-width:0}.form-meta>view{display:flex;flex-direction:column;gap:5rpx}.form-meta b{color:#294a62;font-size:26rpx}.form-meta view text{color:#8497a4;font-size:19rpx;white-space:nowrap}.form-icon{display:grid;place-items:center;flex-shrink:0;width:54rpx;height:54rpx;border-radius:15rpx;background:#e7f1f7;color:#2a6388;font-size:21rpx;font-weight:700}.quantity-icon{background:#e8f4ef;color:#2e765c}.stepper{display:flex;align-items:center;flex-shrink:0;padding:5rpx;border-radius:16rpx;background:#edf4f8}.quantity-btn{width:58rpx;height:58rpx;line-height:54rpx;padding:0;border:0;border-radius:12rpx;background:#fff;color:#245d84;font-size:34rpx;font-weight:600}.quantity-btn::after{border:0}.quantity-input{width:70rpx;height:58rpx;text-align:center;color:#183e5d;font-size:30rpx;font-weight:700}.scan{height:120rpx;border:0;border-radius:22rpx;margin:6rpx 0 0;padding:0 26rpx;display:flex;align-items:center;background:linear-gradient(135deg,#2d739c,#174b70);color:#fff;box-shadow:0 12rpx 28rpx rgba(32,91,130,.2);text-align:left}.scan::after{border:0}.scan-icon{width:65rpx;font-size:43rpx}.scan>view{flex:1;display:flex;flex-direction:column}.scan b{font-size:29rpx}.scan small{margin-top:5rpx;color:#c5dce9;font-size:20rpx}.button-arrow{font-size:42rpx;color:#c5dce9}
.sales-head{margin-top:38rpx}.cash-entry{display:flex;align-items:center;gap:20rpx;padding:26rpx;border-color:#d8e5ed;box-shadow:0 10rpx 28rpx rgba(31,74,105,.07)}.cash-entry:active{background:#f7fafc}.cash-icon{display:grid;place-items:center;flex-shrink:0;width:72rpx;height:72rpx;border-radius:20rpx;background:linear-gradient(145deg,#e5c982,#c79c4e);color:#29463e;font-size:27rpx;font-weight:700}.cash-main{display:flex;flex:1;min-width:0;flex-direction:column;gap:7rpx}.cash-main b{color:#294a62;font-size:28rpx}.cash-main text{overflow:hidden;color:#8396a3;font-size:20rpx;white-space:nowrap;text-overflow:ellipsis}.entry-action{flex-shrink:0;color:#a4772f;font-size:23rpx;font-weight:700}.entry-action text{margin-left:5rpx;font-size:34rpx}.tools-head{margin-top:38rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.tool-card{position:relative;display:flex;flex-direction:column;margin:0;padding:24rpx;border-color:#dce7ee}.tool-card:only-child{grid-column:1/-1}.tool-card:active{background:#f7fafc}.tool-icon{display:grid;place-items:center;width:54rpx;height:54rpx;margin-bottom:18rpx;border-radius:15rpx;background:#e7f1f7;color:#2b658a;font-size:21rpx;font-weight:700}.report-icon{background:#e9f3ef;color:#31735d}.tool-card b{color:#244c68;font-size:26rpx}.tool-card>text{margin-top:7rpx;color:#8195a2;font-size:20rpx}.tool-arrow{position:absolute;right:20rpx;top:22rpx;color:#9aacb7;font-size:34rpx}
