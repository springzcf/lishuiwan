.admin-hero{background:linear-gradient(145deg,#8b672f,#5f431e)}.admin-hero>view:last-child{margin-top:15rpx;color:#ead8b5}.scan,.cash{height:180rpx;border:0;border-radius:26rpx;margin:25rpx 0;display:flex;flex-direction:column;align-items:center;justify-content:center}.scan{background:#145446;color:#fff}.cash{background:#fff4df;color:#795421}.scan b,.cash b{font-size:35rpx}.scan small,.cash small{margin-top:8rpx}.scan-icon{font-size:46rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.grid .card{display:flex;flex-direction:column}.grid text{font-size:22rpx;color:#82968f;margin-top:12rpx}
