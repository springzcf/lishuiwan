<view class="page"><view class="card"><view class="row"><b>{{member.nickname}}</b><text>{{member.phone}}</text></view></view><view wx:if="{{!cards.length}}" class="empty">该会员没有可用权益卡</view><block wx:else><view class="section-title">选择权益卡</view><picker range="{{cards}}" range-key="id" value="{{cardIndex}}" bindchange="cardChange"><view class="field">权益卡 #{{cards[cardIndex].id}}　›</view></picker><view class="section-title">选择权益</view><picker range="{{cards[cardIndex].benefits}}" range-key="item" value="{{benefitIndex}}" bindchange="benefitChange"><view class="field row"><text>{{cards[cardIndex].benefits[benefitIndex].item}}</text><text>剩余 {{cards[cardIndex].benefits[benefitIndex].type==='unlimited'?'不限':cards[cardIndex].benefits[benefitIndex].remaining}} ›</text></view></picker><view class="section-title">本次扣减</view><input class="field" type="digit" value="{{quantity}}" bindinput="quantity"/><view class="card confirm"><view class="row"><text>核销人</text><b>{{operatorName}}</b></view><view class="row"><text>扣减后</text><b>{{cards[cardIndex].benefits[benefitIndex].type==='unlimited'?'不限次':cards[cardIndex].benefits[benefitIndex].remaining-quantity}}</b></view></view><button class="btn" loading="{{submitting}}" bindtap="submit">确认核销</button></block></view>
