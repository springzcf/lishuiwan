<view class="page admin-page"><view class="card"><view class="row"><b>{{member.nickname}}</b><text>{{member.phone}}</text></view></view><view wx:if="{{!card}}" class="empty">未识别到权益卡</view><block wx:else><view class="section-title">本次核销卡</view><view class="card"><view class="row"><b>{{card.productName||'会员权益卡'}}</b><text>#{{card.id}}</text></view><view class="muted">有效期至 {{card.validUntil}}</view></view><view class="section-title">选择权益</view><picker range="{{card.benefits}}" range-key="item" value="{{benefitIndex}}" bindchange="benefitChange"><view class="field row"><text>{{card.benefits[benefitIndex].item}}</text><text>剩余 {{card.benefits[benefitIndex].type==='unlimited'?'不限':card.benefits[benefitIndex].remaining}} ›</text></view></picker><view class="section-title">本次扣减（扫码前已输入）</view><input class="field quantity-confirm" type="digit" value="{{quantity}}" bindinput="quantity"/><view class="card confirm"><view class="row"><text>核销人</text><b>{{operatorName}}</b></view><view class="row"><text>本次扣减</text><b>{{quantity}} {{card.benefits[benefitIndex].type==='hours'?'小时':'次'}}</b></view><view class="row"><text>扣减后</text><b>{{card.benefits[benefitIndex].type==='unlimited'?'不限次':card.benefits[benefitIndex].remaining-quantity}}</b></view></view><button class="btn" loading="{{submitting}}" bindtap="submit">确认核销 {{quantity}} {{card.benefits[benefitIndex].type==='hours'?'小时':'次'}}</button></block></view>
