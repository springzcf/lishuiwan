.admin-page{min-height:100vh;box-sizing:border-box;background:#eef4f8;color:#18344c}.admin-hero{background:linear-gradient(145deg,#234f73 0%,#102f4a 72%,#0b263c 100%);border:1rpx solid rgba(131,190,225,.22);box-shadow:0 18rpx 46rpx rgba(19,57,87,.2)}.admin-hero::after{border-color:rgba(141,201,235,.2);box-shadow:0 0 0 35rpx rgba(126,190,225,.05)}.admin-hero>view:last-child{margin-top:15rpx;color:#c4d9e8}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:24rpx 0}.metrics .card{margin:0;border-color:#dbe7ee}.metrics text{display:block;color:#728a99}.metrics b{display:block;font-size:40rpx;color:#245d84;margin-top:15rpx}
