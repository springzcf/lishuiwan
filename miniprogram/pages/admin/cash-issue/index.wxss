.admin-page{min-height:100vh;box-sizing:border-box;background:#eef4f8;color:#18344c}.admin-page .card{border-color:#dbe7ee}.admin-page .field{box-sizing:border-box;background:#f7fafc;border-color:#d8e5ed}.admin-page .btn{background:linear-gradient(135deg,#2d739c,#174b70)!important;color:#fff!important;box-shadow:0 10rpx 24rpx rgba(32,91,130,.2)}.flow-tip{margin:4rpx 0 22rpx;color:#728a99;font-size:23rpx}.step-card{padding:26rpx;margin-bottom:20rpx}.step-head{display:flex;align-items:center;gap:18rpx;margin-bottom:24rpx}.step-head>view{display:flex;flex-direction:column;gap:6rpx}.step-head b{font-size:29rpx;color:#203f59}.step-head view text{font-size:21rpx;color:#8195a3}.step-no{display:grid;place-items:center;flex-shrink:0;width:48rpx;height:48rpx;border-radius:50%;background:#dcecf5;color:#245d84;font-size:24rpx;font-weight:700}.step-disabled{opacity:.58}.product-picker{margin:0}.placeholder{color:#9baab4}.amount-label{margin:25rpx 0 12rpx;color:#627b8c;font-size:23rpx}.amount{font-size:38rpx;color:#245d84;font-weight:700;margin-bottom:10rpx}.amount-tip{font-size:21rpx}.scan-member{background:#e7f1f7!important;color:#245d84!important;border-radius:40rpx!important;font-weight:700}.scan-member::after{border:0}.member-result{display:flex;align-items:center;gap:18rpx;padding:18rpx;margin-bottom:20rpx;border-radius:16rpx;background:#f0f7f4}.member-avatar{display:grid;place-items:center;width:62rpx;height:62rpx;border-radius:50%;background:#cfe6db;color:#25634d;font-weight:700}.member-main{display:flex;flex:1;flex-direction:column;gap:5rpx}.member-main text{color:#70877f;font-size:22rpx}.verified{color:#2b805e;font-size:21rpx}.password{width:100%;margin:0}.submit-btn{margin-top:28rpx}.submit-btn[disabled]{opacity:.45;box-shadow:none}.security-tip{text-align:center;margin:18rpx 0 24rpx;color:#8498a6;font-size:20rpx}
