.admin-page{min-height:100vh;box-sizing:border-box;background:#eef4f8;color:#18344c}.admin-page .card{border-color:#dbe7ee}.admin-page .section-title{color:#203f59}.admin-page .field{background:#fff;border-color:#d8e5ed}.admin-page .btn{background:linear-gradient(135deg,#2d739c,#174b70)!important;color:#fff!important;box-shadow:0 10rpx 24rpx rgba(32,91,130,.2)}.member{margin-top:15rpx}.amount{font-size:42rpx;color:#245d84;font-weight:700}.warning{line-height:1.7;margin:20rpx 0 50rpx}
