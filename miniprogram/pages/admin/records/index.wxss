.admin-page{min-height:100vh;box-sizing:border-box;background:#eef4f8;color:#18344c}.record-card{padding:26rpx;border-color:#dbe7ee}.record-head{display:flex;align-items:flex-start;justify-content:space-between}.record-head>view:first-child{display:flex;flex-direction:column;gap:5rpx}.record-head b{color:#244a65;font-size:29rpx}.record-head text{color:#8a9ba6;font-size:20rpx}.deduction{padding:7rpx 14rpx;border-radius:18rpx;background:#fbe9e7;color:#b94d45;font-size:25rpx;font-weight:700}.benefit-line{display:flex;align-items:center;gap:14rpx;margin:22rpx 0;padding-bottom:22rpx;border-bottom:1rpx solid #e7eef2}.benefit-line b{font-size:26rpx;color:#29495f}.benefit-tag{padding:5rpx 11rpx;border-radius:12rpx;background:#e5f0f7;color:#2c668a;font-size:19rpx}.customer-block{display:flex;flex-direction:column;gap:15rpx;padding:20rpx;border-radius:16rpx;background:#f4f8fa}.info-row{display:flex;align-items:center;justify-content:space-between}.info-row text{color:#7d919e;font-size:22rpx}.info-row b{color:#29495f;font-size:24rpx}.info-row .phone{color:#1f5c82;letter-spacing:1rpx}.record-foot{display:flex;align-items:flex-end;justify-content:space-between;margin-top:20rpx}.record-foot>view{display:flex;align-items:center;gap:10rpx}.record-foot text{color:#8a9ba6;font-size:19rpx}.record-foot b{color:#526c7e;font-size:21rpx}.record-time{white-space:nowrap}
