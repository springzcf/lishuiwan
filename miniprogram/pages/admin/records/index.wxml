<view class="page admin-page"><view wx:if="{{!items.length}}" class="empty">暂无核销记录</view><view class="card" wx:for="{{items}}" wx:key="id"><view class="row"><b>{{item.itemSnapshot}}</b><text class="danger">-{{item.quantity}}</text></view><view class="muted">会员 {{item.memberId}} · 权益卡 {{item.cardId}}</view><view class="muted">{{item.createdAt}} · {{item.operatorName}}</view></view></view>
