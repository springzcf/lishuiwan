<view class="page"><view wx:if="{{!items.length}}" class="empty">暂无消息</view><view class="card note" wx:for="{{items}}" wx:key="id"><view class="dot {{item.isRead?'read':''}}"></view><view><b>{{item.title}}</b><view class="content">{{item.content}}</view><view class="muted">{{item.createdAt}}</view></view></view></view>
