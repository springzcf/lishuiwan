<view class="page"><view wx:if="{{!orders.length}}" class="empty">暂无订单</view><view class="card" wx:for="{{orders}}" wx:key="id"><view class="row"><b>{{item.item.name|| (item.payMethod==='cash'?'现金购卡':'微信购卡')}}</b><text class="tag">{{item.payStatus===0?'待支付':item.payStatus===1?'已支付':'已关闭'}}</text></view><view class="amount">¥{{item.paidAmount||item.payableAmount}}</view><view class="muted">{{item.payMethod==='cash'?'现金购买':'微信支付'}} · 订单号 {{item.orderNo}}</view><view class="muted">{{item.paidAt||item.createdAt}}</view></view></view>
