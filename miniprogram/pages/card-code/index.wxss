page{background:linear-gradient(180deg,#123f36 0,#123f36 390rpx,#f7f4ed 390rpx,#f7f4ed 100%)}.code-page{padding:40rpx 36rpx 60rpx}.card-summary{color:#fff;margin-bottom:30rpx}.summary-label{color:#ddc17e;font-size:21rpx}.summary-name{margin-top:12rpx;font-size:38rpx;font-weight:700}.summary-id{margin-top:10rpx;color:#c9d9d4;font-size:22rpx}
.code-card{background:#fffdf9;border:1rpx solid rgba(190,157,92,.15);border-radius:32rpx;padding:30rpx 30rpx 38rpx;box-shadow:0 20rpx 60rpx rgba(38,47,35,.16);text-align:center}.live-badge{display:inline-flex;align-items:center;gap:12rpx;padding:9rpx 18rpx;margin-bottom:24rpx;border-radius:30rpx;background:#f4ead4;color:#7f622e;font-size:21rpx}.pulse{display:inline-block;width:11rpx;height:11rpx;border-radius:50%;background:#c79a45;box-shadow:0 0 0 7rpx rgba(199,154,69,.14)}
.canvas-wrap{position:relative;width:540rpx;height:540rpx;padding:14rpx;box-sizing:border-box;margin:auto;background:#fff;border:1rpx solid #e2ebe7;border-radius:24rpx}.qrcode{display:block;width:512rpx;height:512rpx}.canvas-state{position:absolute;inset:14rpx;display:flex;align-items:center;justify-content:center;background:#fff;color:#879a94;font-size:25rpx}.canvas-state.error{color:#b14d45}.refresh{margin-top:24rpx;color:#3f6e62;font-size:24rpx;font-weight:600}.safe-tip{margin-top:15rpx;color:#8a9d97;font-size:21rpx}
.usage-tip{display:flex;flex-direction:column;gap:9rpx;margin-top:24rpx;padding:25rpx 27rpx;background:#fff;border-radius:22rpx;color:#173a32}.usage-tip b{font-size:27rpx}.usage-tip text{color:#879a94;font-size:22rpx;line-height:1.7}
