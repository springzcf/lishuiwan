<view class="page"><view class="hero"><view class="hero-small">LISHUIWAN BATHHOUSE</view><view class="title">丽水湾洗浴中心</view><view class="hero-sub">安心洗浴 · 舒适相伴</view></view><swiper wx:if="{{activities.length}}" class="banners" autoplay circular indicator-dots><swiper-item wx:for="{{activities}}" wx:key="id"><image src="{{item.image}}" mode="aspectFill"/></swiper-item></swiper><view class="section-title">会员权益卡</view><view class="product card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="select"><image src="{{item.cover}}" mode="aspectFill"/><view class="product-main"><view class="row"><b>{{item.name}}</b><text class="tag">{{item.category}}</text></view><view class="muted">购买后 {{item.validDays}} 天内有效</view><view class="row"><view><text class="price">¥{{item.currentPrice}}</text><text class="old">¥{{item.price}}</text></view><text class="arrow">›</text></view></view></view></view><view wx:if="{{show}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop"><view class="grab"></view><view class="title">{{selected.name}}</view><view class="price">¥{{selected.currentPrice}}</view><view class="benefit" wx:for="{{selected.benefits}}" wx:key="benefitId"><text>✓ {{item.item}}</text><b>{{item.type==='unlimited'?'不限次':item.total+(item.type==='hours'?' 小时':' 次')}}</b></view><view class="rules">{{selected.rules}}</view><button class="btn" loading="{{buying}}" bindtap="buy">立即购买</button></view></view>
