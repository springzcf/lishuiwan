.hero-small{font-size:18rpx;letter-spacing:5rpx;color:#d9bd7b}.hero-sub{margin-top:18rpx;color:#d4e1dd}.banners{height:260rpx;margin-top:22rpx;border-radius:24rpx;overflow:hidden;box-shadow:0 12rpx 32rpx rgba(49,38,19,.12)}.banners image{width:100%;height:100%}.product{display:flex;padding:0;overflow:hidden}.product image{width:210rpx;height:210rpx;background:#ece5d7}.product-main{padding:24rpx;flex:1}.product-main b{font-size:31rpx;color:#203d35}.product-main .muted{margin:16rpx 0 24rpx}.old{margin-left:12rpx;color:#aaa9a3;text-decoration:line-through}.arrow{font-size:44rpx;color:#b4965d}.mask{position:fixed;inset:0;background:rgba(8,27,22,.58);z-index:20}.sheet{position:absolute;bottom:0;width:100%;box-sizing:border-box;background:#fffdf9;border-radius:34rpx 34rpx 0 0;padding:26rpx 34rpx 50rpx}.grab{width:80rpx;height:8rpx;background:#ddd6c8;border-radius:5rpx;margin:0 auto 28rpx}.benefit{display:flex;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #eee8dd}.benefit text{color:#4d625c}.benefit b{color:#8b6529}.rules{color:#71817b;line-height:1.7;padding:25rpx 0}
