page{background:linear-gradient(180deg,#123f36 0,#123f36 360rpx,#f7f4ed 360rpx,#f7f4ed 100%)}
.code-page{padding:48rpx 36rpx 60rpx}.code-intro{color:#fff;text-align:center;margin-bottom:34rpx}.intro-eyebrow{font-size:19rpx;letter-spacing:5rpx;color:#ddc17e}.intro-title{margin-top:13rpx;font-size:42rpx;font-weight:700}.intro-desc{margin-top:12rpx;color:#c9d9d4;font-size:24rpx}
.code-card{background:#fff;border-radius:32rpx;padding:30rpx 30rpx 38rpx;box-shadow:0 20rpx 60rpx rgba(12,55,46,.16);text-align:center}.live-badge{display:inline-flex;align-items:center;gap:12rpx;padding:9rpx 18rpx;margin-bottom:24rpx;border-radius:30rpx;background:#edf7f3;color:#357565;font-size:21rpx}
.id-dot{display:inline-grid;place-items:center;width:38rpx;height:38rpx;border-radius:50%;background:#f1e5c9;color:#8a6427;font-size:16rpx;font-weight:700}.canvas-wrap{position:relative;width:540rpx;height:540rpx;padding:14rpx;box-sizing:border-box;margin:auto;background:#fff;border:1rpx solid #e8dfcf;border-radius:24rpx}.qrcode{display:block;width:512rpx;height:512rpx}
.canvas-state{position:absolute;inset:14rpx;display:flex;align-items:center;justify-content:center;background:#fff;color:#879a94;font-size:25rpx}.canvas-state.error{color:#b14d45}.refresh{margin-top:24rpx;color:#3f6e62;font-size:24rpx;font-weight:600}.safe-tip{margin-top:15rpx;color:#8a9d97;font-size:21rpx}
.notice-card{display:flex;align-items:center;gap:18rpx;margin-top:24rpx;padding:25rpx 27rpx;background:#fff;border-radius:22rpx;box-shadow:0 10rpx 34rpx rgba(20,65,53,.055)}.notice-card:active{background:#f8fbfa}.notice-icon{width:60rpx;height:60rpx;border-radius:16rpx;display:grid;place-items:center;background:#edf0fb;color:#536db1;font-size:23rpx;font-weight:700}.notice-main{flex:1}.notice-title{font-size:28rpx;font-weight:700;color:#173a32}.notice-desc{margin-top:6rpx;color:#879a94;font-size:21rpx}.notice-arrow{color:#a0b2ac;font-size:38rpx}.tip{color:#879a94;font-size:21rpx;margin-top:28rpx;text-align:center}
