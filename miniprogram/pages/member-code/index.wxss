.code-page{padding:80rpx 36rpx;text-align:center}.code-card{background:#fff;border-radius:32rpx;padding:45rpx 30rpx;box-shadow:0 20rpx 60rpx #153f3420}.code-card .muted{margin:14rpx 0 36rpx}.canvas-wrap{width:560rpx;height:560rpx;padding:20rpx;margin:auto;background:#fff;border:1rpx solid #e2ebe7}.refresh{font-size:23rpx;color:#55756c;margin-top:28rpx}.pulse{display:inline-block;width:13rpx;height:13rpx;border-radius:50%;background:#39a47c}.notice{margin-top:28rpx}.tip{color:#879a94;font-size:23rpx;margin-top:36rpx}
