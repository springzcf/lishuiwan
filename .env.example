# 复制为 .env 后填写正式值。所有 change-me、example.com 和示例 AppID 都必须替换。
# .env 与 secrets/ 包含密码和私钥，禁止提交 Git、发送到聊天或放入公开网盘。
APP_ENV_FILE=.env

# MySQL 业务用户密码、MySQL root 密码、Redis 密码必须分别生成，禁止复用。
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
REDIS_PASSWORD=change-me-redis-password
# JWT 签名密钥，至少 32 个字符；更换后会使所有现有登录失效。
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# 仅用于首次创建后台管理员。创建正式管理员后可将密码留空并重启 API，避免长期保存初始密码。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-at-least-12-characters
INITIAL_ADMIN_NAME=系统管理员

# ===== 微信小程序 =====
# 小程序 AppID/AppSecret：微信公众平台（小程序）→ 开发管理 → 开发设置。
# 用于原小程序登录、手机号绑定、小程序订阅消息以及小程序内 JSAPI 支付。
# AppSecret 只允许保存在后端，绝不能写入 miniprogram 前端代码。
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=change-me

# ===== 微信服务号 H5 =====
# 是否启用服务号网页静默授权。启用 H5 正式入口时设为 true；未配置服务号时可设为 false。
WECHAT_OFFICIAL_ENABLED=true
# 服务号自己的 AppID/AppSecret，不要误填成上面的小程序 AppID/AppSecret。
# 获取位置：微信公众平台（服务号）→ 设置与开发 → 基本配置。
WECHAT_OFFICIAL_APP_ID=wx0000000000000000
WECHAT_OFFICIAL_APP_SECRET=change-me
# 微信网页授权完成后回调到后端的完整 HTTPS 地址；域名必须已配置为服务号网页授权域名。
WECHAT_OFFICIAL_OAUTH_CALLBACK_URL=https://api.example.com/api/public/h5/wechat/callback
# H5 根地址，必须以 /h5/ 结尾。授权成功后系统会从这里跳转到活动页或个人中心。
H5_BASE_URL=https://api.example.com/h5/

# 服务号与小程序必须绑定到同一个微信开放平台账号，才能通过相同 UnionID 自动合并会员。

# ===== 小程序订阅消息（可选） =====
# 核销成功、现金发卡通知的小程序订阅消息模板 ID；留空时保留站内通知，但不推送微信消息。
WECHAT_VERIFY_TEMPLATE_ID=
WECHAT_ISSUE_TEMPLATE_ID=
# 模板详情中的“事项/内容”和“时间”字段名，例如 thing1、time2；不是实际显示文案。
# 当前两个通知模板共用这组字段名，因此建议选择字段编号一致的两个模板。
WECHAT_TEMPLATE_THING_KEY=thing1
WECHAT_TEMPLATE_TIME_KEY=time2

# ===== 微信支付 APIv3 =====
# 是否启用真实微信支付。参数未准备完毕时设为 false；生产环境禁止使用模拟支付代替。
WECHAT_PAY_ENABLED=true
# 微信支付商户号 mchid。小程序 AppID 和服务号 AppID 都应与该商户号建立支付绑定关系。
WECHAT_PAY_MCH_ID=1900000000
# 商户 API 证书序列号：必须与 apiclient_key.pem 属于同一张商户证书。
# 不是商户号、微信支付平台证书序列号、订单号或 APIv3 密钥。
WECHAT_PAY_SERIAL_NO=change-me
# 容器内商户私钥路径，通常不要修改。服务器实际文件放在 ./secrets/apiclient_key.pem。
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/apiclient_key.pem
# 微信支付商户平台中设置的 APIv3 密钥，必须为 32 个字符；不是 AppSecret 或 APIv2 密钥。
# 用于支付回调解密和微信支付平台证书处理，泄露后必须立即在商户平台重置。
WECHAT_PAY_API_V3_KEY=change-me-32-bytes
# 微信支付成功通知地址：必须为公网可访问的 HTTPS 地址，不能要求用户登录或被防火墙拦截。
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/public/wx/pay/notify

# 生产环境必须保持为 false。一键部署脚本会拒绝开启开发登录或模拟支付的配置。
MOCK_PAYMENT_ENABLED=false
DEV_LOGIN_ENABLED=false
# Web 对宿主机的监听地址和端口。宿主机 Nginx 反向代理时建议使用 127.0.0.1 和 8088；
# 云负载均衡直接访问容器宿主机时可使用 0.0.0.0 和 80，并由安全组限制来源。
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# ===== Docker 基础镜像（可选） =====
# 默认从 Docker Hub 拉取，下列值不配置也能运行。中国大陆服务器无法稳定访问 Docker Hub 时，
# 可将它们改成已同步到自己阿里云 ACR 仓库的完整镜像地址；不要使用来源不明的公共代理镜像。
# Java 构建和运行默认使用 Amazon Corretto 17，并从 ECR Public 拉取以绕过 Docker Hub 镜像加速器。
# 如果服务器也无法访问 public.ecr.aws，再将镜像同步到自己的阿里云 ACR 并填写 ACR 完整地址。
MAVEN_BASE_IMAGE=public.ecr.aws/docker/library/maven:3.9.16-amazoncorretto-17-alpine
JAVA_RUNTIME_IMAGE=public.ecr.aws/docker/library/amazoncorretto:17-alpine
NODE_BASE_IMAGE=node:24-alpine
NGINX_BASE_IMAGE=nginx:1.28-alpine
MYSQL_BASE_IMAGE=mysql:8.4
REDIS_BASE_IMAGE=redis:7.4-alpine
